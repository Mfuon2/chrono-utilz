{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "mocha",
  "mochaOptions": {
    "require": [
      "ts-node/register"
    ],
    "spec": [
      "tests/**/*.test.ts"
    ]
  },
  "mutate": [
    "src/getISOWeek.ts",
    "src/fromTimestamp.ts",
    "src/convertTimezone.ts",
    "src/isLeapYear.ts"
  ],
  "coverageAnalysis": "off",
  "concurrency": 2,
  "timeoutMS": 3000,
  "reporters": [
    "clear-text",
    "json",
    "html"
  ],
  "thresholds": {
    "high": 90,
    "low": 75,
    "break": 95
  }
}
